    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "eslint": "^10.9.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.68.0"
